rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Subjects, Chapters, Lessons, Activities: everyone authenticated can read
    match /subjects/{doc} {
      allow read: if request.auth != null;
      allow write: if false; // Admin only — manage via Firebase Console
    }
    match /chapters/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /lessons/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /activities/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Progress: users can read/write only their own progress
    match /progress/{docId} {
      allow read, write: if request.auth != null
        && docId.matches(request.auth.uid + '_.*');
    }

    // Forum posts: all authenticated users can read & create
    match /forumPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && resource.data.authorId == request.auth.uid;
      allow delete: if false;
    }

    // Monthly reports: users see only their own
    match /monthlyReports/{docId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false; // Written by Cloud Functions only
    }
  }
}
